{
  "name": "sd-admin-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "SD 사용자 접속 현황 및 관리자 지갑 운영 도구",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "test:bug": "node --test tests/bug-regression.test.js tests/presence-bug-regression.test.js",
    "test:error": "node --test tests/error-resilience.test.js tests/presence-error-resilience.test.js",
    "build:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "com.sd608.adminmonitor",
    "productName": "SD 사용자 현황",
    "asar": true,
    "files": ["main.js", "preload.js", "lib/**/*", "renderer/**/*", "package.json"],
    "directories": {"output": "dist"},
    "win": {"target": ["nsis"]},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true}
  }
}
