# Discord Developer Portal
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# 개발 중에는 서버 명령어 등록이 즉시 반영되도록 Guild ID 사용을 권장합니다.
DISCORD_GUILD_ID=

# 업데이트 공지를 보낼 텍스트 채널 ID
UPDATE_CHANNEL_ID=

# Supabase - service_role 키는 서버에서만 사용하고 절대 GitHub에 커밋하지 마세요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 업데이트 확인 주기(ms). 기본 60000 = 1분
UPDATE_POLL_INTERVAL_MS=60000

# 필요하면 다른 배포 주소로 교체 가능
CENTER_UPDATE_URL=https://sd608.github.io/sd-center/update/center-update.json
EXTENSIONS_CATALOG_URL=https://sd608.github.io/sd-center/update/extensions-catalog.json
